FROM rust:1-slim-trixie AS builder

WORKDIR /app

RUN apt-get update && \
    apt-get install -y --no-install-recommends build-essential ca-certificates cmake pkg-config && \
    rm -rf /var/lib/apt/lists/*

COPY Cargo.toml Cargo.lock ./
COPY crates/ crates/
COPY apps/ apps/

RUN cargo build --locked --release --package oxidgene-worker

FROM debian:trixie-slim AS runtime

RUN apt-get update && \
    apt-get install -y --no-install-recommends ca-certificates && \
    rm -rf /var/lib/apt/lists/* && \
    groupadd --gid 1000 oxidgene && \
    useradd --uid 1000 --gid oxidgene --create-home oxidgene

COPY --from=builder /app/target/release/oxidgene-worker /usr/local/bin/oxidgene-worker

USER oxidgene
WORKDIR /home/oxidgene

ENV OXIDGENE_LOG_LEVEL=info

ENTRYPOINT ["oxidgene-worker"]
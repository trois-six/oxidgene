# The build image of the development overlay (docker-compose.dev.yml): the
# Rust release rust-toolchain.toml pins, with its WebAssembly target and
# components; the clang and mold linkers .cargo/config.toml names; the
# Dioxus CLI; and watchexec, which rebuilds the backend when a source
# changes. It holds no source: the overlay mounts the checkout read-only
# and keeps target/ and the Cargo registry in volumes.
FROM rust:1-slim-trixie

RUN apt-get update && \
    apt-get install -y --no-install-recommends build-essential ca-certificates clang cmake curl \
        libssl-dev mold pkg-config && \
    rm -rf /var/lib/apt/lists/*

# The toolchain file is the one source of the release: rustup installs it
# here, with the targets and components it lists, and selects it in /app.
WORKDIR /app
COPY rust-toolchain.toml ./
RUN rustup toolchain install

RUN cargo install --locked watchexec-cli --version 2.8.0 && \
    cargo install --locked dioxus-cli --version 0.7.10 && \
    rm -rf /usr/local/cargo/registry

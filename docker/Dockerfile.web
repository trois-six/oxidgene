# ── Builder stage ──────────────────────────────────────────────────────
FROM rust:1-slim-trixie AS builder

WORKDIR /app

RUN apt-get update && \
    apt-get install -y --no-install-recommends brotli build-essential ca-certificates curl libssl-dev pkg-config && \
    rm -rf /var/lib/apt/lists/* && \
    rustup target add wasm32-unknown-unknown && \
    cargo install dioxus-cli --version 0.7.10 --locked

COPY Cargo.toml Cargo.lock ./
COPY crates/ crates/
COPY apps/ apps/
COPY assets/themes/ assets/themes/
COPY assets/portraits/ assets/portraits/
COPY assets/fonts/ assets/fonts/
COPY assets/brand/logo_64.png assets/brand/logo_64.png
COPY scripts/dx.sh scripts/dx.sh

# An empty base URL makes browser API calls same-origin for Kubernetes Ingress.
# Compose overrides it with the API port published on the developer's host.
ARG OXIDGENE_API_URL=""
ARG OXIDGENE_LOG_LEVEL="info"
ARG OTEL_EXPORTER_OTLP_ENDPOINT=""
RUN OXIDGENE_API_URL="${OXIDGENE_API_URL}" OXIDGENE_LOG_LEVEL="${OXIDGENE_LOG_LEVEL}" \
    OTEL_EXPORTER_OTLP_ENDPOINT="${OTEL_EXPORTER_OTLP_ENDPOINT}" \
    scripts/dx.sh build --package oxidgene-web --platform web --release

# Precompress the bundle once, as Brotli at its highest quality and as gzip
# at its highest level, for nginx's brotli_static and gzip_static: every
# request gets the smallest encoding its client accepts without nginx
# compressing anything at serve time. -n keeps the gzip archives
# reproducible.
RUN find target/dx/oxidgene-web/release/web/public -type f -size +1k \
        \( -name '*.wasm' -o -name '*.js' -o -name '*.css' -o -name '*.html' \
           -o -name '*.json' -o -name '*.svg' \) \
        -exec gzip -9 -k -n {} + \
        -exec brotli -q 11 -k {} +

# The Content-Security-Policy lets the page connect to its own origin and to
# the origins of the API and OTLP endpoint baked into this bundle.
RUN connect=""; \
    for url in "${OXIDGENE_API_URL}" "${OTEL_EXPORTER_OTLP_ENDPOINT}"; do \
        origin=$(printf '%s' "$url" | sed -nE 's#^(https?://[^/]+).*#\1#p'); \
        if [ -n "$origin" ]; then connect="${connect} ${origin}"; fi; \
    done; \
    printf 'set $csp_connect_src "%s";\n' "${connect# }" > csp-connect-src.conf

# ── Runtime stage ─────────────────────────────────────────────────────
# Debian's nginx, for its packaged Brotli module (neither the official nginx
# image nor nginx-unprivileged ships one), set up the way nginx-unprivileged
# sets up its own: a dedicated system user (101 by default), configuration
# and cache owned by that user and group 0 and group-writable so an arbitrary
# UID of group 0 can run it, logs linked to the container's stdout and
# stderr, every runtime write under /tmp (pid and temporary files, see
# nginx-web.conf) so the root filesystem can stay read-only, an unprivileged
# port, and SIGQUIT for a graceful stop.
FROM debian:trixie-slim AS runtime

ARG UID=101
ARG GID=101

RUN groupadd --system --gid "$GID" nginx && \
    useradd --system --gid nginx --no-create-home --home /nonexistent \
        --comment "nginx user" --shell /usr/sbin/nologin --uid "$UID" nginx && \
    apt-get update && \
    apt-get install -y --no-install-recommends nginx libnginx-mod-http-brotli-static && \
    rm -rf /var/lib/apt/lists/* /etc/nginx/sites-enabled /etc/nginx/sites-available \
        /etc/nginx/conf.d /var/www/html && \
    ln -sf /dev/stdout /var/log/nginx/access.log && \
    ln -sf /dev/stderr /var/log/nginx/error.log && \
    chown -R "$UID:0" /var/lib/nginx /etc/nginx && \
    chmod -R g+w /var/lib/nginx /etc/nginx

COPY docker/nginx-web.conf /etc/nginx/nginx.conf
COPY docker/security-headers.conf /etc/nginx/security-headers.conf
COPY --from=builder /app/csp-connect-src.conf /etc/nginx/csp-connect-src.conf
COPY --from=builder /app/target/dx/oxidgene-web/release/web/public/ /usr/share/nginx/html/
COPY docker/runtime-config.js /usr/share/nginx/html/runtime-config.js

EXPOSE 8080
STOPSIGNAL SIGQUIT
USER $UID
CMD ["nginx", "-g", "daemon off;"]

# ── Builder stage ──────────────────────────────────────────────────────
FROM rust:1-slim-trixie AS builder

WORKDIR /app

RUN apt-get update && \
    apt-get install -y --no-install-recommends build-essential ca-certificates curl libssl-dev pkg-config && \
    rm -rf /var/lib/apt/lists/* && \
    rustup target add wasm32-unknown-unknown && \
    cargo install dioxus-cli --version 0.7.10 --locked

COPY Cargo.toml Cargo.lock ./
COPY crates/ crates/
COPY apps/ apps/
COPY scripts/dx.sh scripts/dx.sh

# An empty base URL makes browser API calls same-origin for Kubernetes Ingress.
# Compose overrides it with the API port published on the developer's host.
ARG OXIDGENE_API_URL=""
ARG OXIDGENE_LOG_LEVEL="info"
ARG OTEL_EXPORTER_OTLP_ENDPOINT=""
RUN OXIDGENE_API_URL="${OXIDGENE_API_URL}" OXIDGENE_LOG_LEVEL="${OXIDGENE_LOG_LEVEL}" \
    OTEL_EXPORTER_OTLP_ENDPOINT="${OTEL_EXPORTER_OTLP_ENDPOINT}" \
    scripts/dx.sh build --package oxidgene-web --platform web --release

# ── Runtime stage ─────────────────────────────────────────────────────
FROM nginxinc/nginx-unprivileged:1.31-trixie AS runtime

RUN rm /etc/nginx/conf.d/default.conf

COPY docker/nginx-web.conf /etc/nginx/nginx.conf
COPY --from=builder /app/target/dx/oxidgene-web/release/web/public/ /usr/share/nginx/html/
COPY docker/runtime-config.js /usr/share/nginx/html/runtime-config.js

USER 101

EXPOSE 8080

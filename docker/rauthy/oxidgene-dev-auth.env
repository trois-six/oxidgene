# The server's sign-in settings against the development Rauthy
# (bootstrap/, docs/authentication.md §8.5), shared by the Compose stack's
# server and by `OXIDGENE_AUTH_MODE=oidc just dev-web`. Development values
# only: the secrets below are public, and the stack is bound to loopback.
OXIDGENE_AUTH_MODE=oidc
OXIDGENE_PUBLIC_URL=http://localhost:8081
# Rauthy's issuer ends with a slash, which the comparison keeps.
OXIDGENE_OIDC_ISSUER=http://localhost:8180/auth/v1/
OXIDGENE_OIDC_CLIENT_ID=oxidgene-web
OXIDGENE_OIDC_CLIENT_SECRET=oxidgeneDevelopmentWebClientSecretForTheComposeStackOnly00000000
OXIDGENE_OIDC_TRUSTED_CLIENTS=oxidgene-mcp
OXIDGENE_OIDC_ROLES_CLAIM=groups
OXIDGENE_OIDC_ADMIN_VALUES=oxidgene-admins
OXIDGENE_OIDC_CREATOR_VALUES=oxidgene-creators
OXIDGENE_OIDC_ACCOUNT_URL=http://localhost:8180/auth/v1/account
# Every user of the provider may sign in, so the journeys need no invitation
# to sign the fictitious users up; `invitation` admits invited addresses only.
OXIDGENE_AUTH_SIGNUP=open
OXIDGENE_AUTH_BOOTSTRAP_ADMIN_EMAIL=admin@example.invalid
# base64 of the 32 bytes "oxidgene-development-session-key".
OXIDGENE_SESSION_KEYS=b3hpZGdlbmUtZGV2ZWxvcG1lbnQtc2Vzc2lvbi1rZXk=
# OxidGene's own mail (docs/messaging.md §3.5): the stack's Mailpit, which
# keeps every mail on http://127.0.0.1:8025 and delivers none. On the
# loopback for `just dev-web`; the Compose stack points its server and
# worker at the `mailpit` service instead.
OXIDGENE_SMTP_HOST=localhost
OXIDGENE_SMTP_PORT=1025
OXIDGENE_SMTP_TLS=none
OXIDGENE_MAIL_FROM=OxidGene development <oxidgene@example.invalid>

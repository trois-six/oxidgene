{
  "name": "OxidGene",
  "confidential": true,
  "redirect_uris": ["http://localhost:8081/auth/callback"],
  "post_logout_redirect_uris": ["http://localhost:8081/"],
  "backchannel_logout_uri": "http://server:8080/auth/backchannel-logout",
  "enabled": true,
  "flows_enabled": ["authorization_code", "refresh_token"],
  "access_token_alg": "EdDSA",
  "id_token_alg": "EdDSA",
  "auth_code_lifetime": 60,
  "access_token_lifetime": 300,
  "scopes": ["openid", "profile", "email", "groups", "tree:read", "tree:write", "media:read", "media:write", "import", "export", "history:read", "tree:admin", "instance:admin"],
  "default_scopes": ["openid", "profile", "email", "groups", "tree:read", "tree:write", "media:read", "media:write", "import", "export", "history:read", "tree:admin", "instance:admin"],
  "challenges": ["S256"],
  "force_mfa": false,
  "default_aud": ["http://localhost:8081"]
}

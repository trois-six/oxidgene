{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended",
    ":semanticCommits"
  ],
  "enabledManagers": [
    "cargo",
    "custom.regex",
    "docker-compose",
    "dockerfile",
    "github-actions",
    "helm-values",
    "helmv3"
  ],
  "customManagers": [
    {
      "customType": "regex",
      "managerFilePatterns": ["/^docker\\/Dockerfile\\.web$/"],
      "matchStrings": [
        "cargo install dioxus-cli --version (?<currentValue>[^ ]+) --locked"
      ],
      "datasourceTemplate": "crate",
      "depNameTemplate": "dioxus-cli",
      "versioningTemplate": "cargo"
    },
    {
      "customType": "regex",
      "description": "The pinned Rust release (see docs/development.md before merging)",
      "managerFilePatterns": ["/^rust-toolchain\\.toml$/"],
      "matchStrings": ["channel = \"(?<currentValue>[0-9]+\\.[0-9]+\\.[0-9]+)\""],
      "datasourceTemplate": "github-releases",
      "depNameTemplate": "rust-lang/rust",
      "versioningTemplate": "semver"
    }
  ],
  "timezone": "Europe/Paris",
  "schedule": ["* 3-6 * * 1"],
  "minimumReleaseAge": "7 days",
  "minimumReleaseAgeBehaviour": "timestamp-optional",
  "internalChecksFilter": "strict",
  "rebaseWhen": "behind-base-branch",
  "prConcurrentLimit": 5,
  "lockFileMaintenance": {
    "enabled": true,
    "schedule": ["* 3-6 * * 1"]
  },
  "packageRules": [
    {
      "description": "Keep Cargo manifests broad and update the resolved workspace graph",
      "matchManagers": ["cargo"],
      "rangeStrategy": "update-lockfile"
    },
    {
      "description": "Test non-major Rust dependency updates as one coherent graph",
      "matchManagers": ["cargo"],
      "matchUpdateTypes": ["minor", "patch"],
      "groupName": "Rust dependencies (non-major)"
    },
    {
      "description": "Track GTK binding upgrades as an explicit desktop migration. Listed after the non-major group because the last matching rule wins",
      "matchManagers": ["cargo"],
      "matchPackageNames": ["glib", "gtk"],
      "groupName": "GTK bindings",
      "dependencyDashboardApproval": true,
      "automerge": false
    },
    {
      "description": "Hold crates aligned with a framework's version until it moves, so the graph gains no duplicate (scripts/budgets.json): getrandom with rand, gloo-timers with dioxus-web, sha2 with sqlx-core and wry, dirs with wry and tray-icon",
      "matchManagers": ["cargo"],
      "matchPackageNames": ["getrandom", "gloo-timers", "sha2", "dirs"],
      "groupName": "Framework-aligned crates",
      "dependencyDashboardApproval": true,
      "automerge": false
    },
    {
      "description": "Each brotli release depends on one brotli-decompressor release: update them together",
      "matchManagers": ["cargo"],
      "matchPackageNames": ["brotli", "brotli-decompressor"],
      "groupName": "Brotli"
    },
    {
      "description": "Keep the Dioxus framework and its build CLI aligned",
      "matchPackageNames": ["dioxus", "dioxus-cli"],
      "groupName": "Dioxus",
      "separateMajorMinor": false
    },
    {
      "description": "Test non-major GitHub Actions updates together",
      "matchManagers": ["github-actions"],
      "matchUpdateTypes": ["minor", "patch", "digest", "pinDigest"],
      "groupName": "GitHub Actions (non-major)"
    },
    {
      "description": "Automerge stable non-major updates after CI succeeds",
      "matchManagers": [
        "cargo",
        "docker-compose",
        "dockerfile",
        "github-actions",
        "helm-values",
        "helmv3"
      ],
      "matchCurrentVersion": "/^v?[1-9][0-9]*(\\.[0-9]+)*/",
      "matchUpdateTypes": ["minor", "patch", "digest", "pinDigest"],
      "additionalBranchPrefix": "automerge-",
      "automerge": true,
      "automergeType": "pr"
    },
    {
      "description": "Automerge lock refreshes that stay within declared constraints",
      "matchManagers": ["cargo", "helmv3"],
      "matchUpdateTypes": ["lockFileMaintenance"],
      "additionalBranchPrefix": "automerge-",
      "automerge": true,
      "automergeType": "pr"
    },
    {
      "description": "Require dashboard approval for breaking updates",
      "matchUpdateTypes": ["major"],
      "dependencyDashboardApproval": true
    }
  ]
}
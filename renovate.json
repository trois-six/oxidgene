{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended",
    ":semanticCommits",
    "helpers:pinGitHubActionDigests"
  ],
  "enabledManagers": [
    "cargo",
    "custom.regex",
    "docker-compose",
    "dockerfile",
    "github-actions",
    "helm-values",
    "helmv3"
  ],
  "customManagers": [
    {
      "customType": "regex",
      "managerFilePatterns": ["/^docker\\/Dockerfile\\.web$/", "/^docker\\/Dockerfile\\.dev$/"],
      "matchStrings": [
        "cargo install (?:--locked )?dioxus-cli --version (?<currentValue>[^ ]+)"
      ],
      "datasourceTemplate": "crate",
      "depNameTemplate": "dioxus-cli",
      "versioningTemplate": "cargo"
    },
    {
      "customType": "regex",
      "description": "The development image's file watcher",
      "managerFilePatterns": ["/^docker\\/Dockerfile\\.dev$/"],
      "matchStrings": [
        "cargo install --locked watchexec-cli --version (?<currentValue>[^ ]+)"
      ],
      "datasourceTemplate": "crate",
      "depNameTemplate": "watchexec-cli",
      "versioningTemplate": "cargo"
    },
    {
      "customType": "regex",
      "description": "The vendored pdf.js: the bot bumps VERSION alone, and .github/workflows/pdfjs.yml vendors the files on its branch (docs/development.md §2.6)",
      "managerFilePatterns": ["/^assets\\/public\\/pdfjs\\/VERSION$/"],
      "matchStrings": ["pdfjs-dist (?<currentValue>[0-9]+\\.[0-9]+\\.[0-9]+) "],
      "datasourceTemplate": "npm",
      "depNameTemplate": "pdfjs-dist",
      "versioningTemplate": "semver"
    },
    {
      "customType": "regex",
      "description": "The pinned Rust release (see docs/development.md before merging)",
      "managerFilePatterns": ["/^rust-toolchain\\.toml$/"],
      "matchStrings": ["channel = \"(?<currentValue>[0-9]+\\.[0-9]+\\.[0-9]+)\""],
      "datasourceTemplate": "github-releases",
      "depNameTemplate": "rust-lang/rust",
      "versioningTemplate": "semver"
    }
  ],
  "timezone": "Europe/Paris",
  "schedule": ["* 3-6 * * 1"],
  "minimumReleaseAge": "7 days",
  "minimumReleaseAgeBehaviour": "timestamp-optional",
  "internalChecksFilter": "strict",
  "rebaseWhen": "behind-base-branch",
  "prConcurrentLimit": 5,
  "lockFileMaintenance": {
    "enabled": true,
    "schedule": ["* 3-6 * * 1"]
  },
  "packageRules": [
    {
      "description": "Keep Cargo manifests broad and update the resolved workspace graph",
      "matchManagers": ["cargo"],
      "rangeStrategy": "update-lockfile"
    },
    {
      "description": "Test non-major Rust dependency updates as one coherent graph",
      "matchManagers": ["cargo"],
      "matchUpdateTypes": ["minor", "patch"],
      "groupName": "Rust dependencies (non-major)"
    },
    {
      "description": "Track GTK binding upgrades as an explicit desktop migration: wry pins webkit2gtk exactly and builds on gtk 0.18, so none of them moves before wry does. Listed after the non-major group because the last matching rule wins",
      "matchManagers": ["cargo"],
      "matchPackageNames": ["glib", "gtk", "webkit2gtk"],
      "groupName": "GTK bindings",
      "dependencyDashboardApproval": true,
      "automerge": false
    },
    {
      "description": "Hold crates aligned with a framework's version until it moves, so the graph gains no duplicate (scripts/budgets.json): getrandom with rand, gloo-timers with dioxus-web, sha2 with sqlx and rmcp, dirs with wry and tray-icon",
      "matchManagers": ["cargo"],
      "matchPackageNames": ["getrandom", "gloo-timers", "sha2", "dirs"],
      "groupName": "Framework-aligned crates",
      "dependencyDashboardApproval": true,
      "automerge": false
    },
    {
      "description": "Each brotli release depends on one brotli-decompressor release: update them together",
      "matchManagers": ["cargo"],
      "matchPackageNames": ["brotli", "brotli-decompressor"],
      "groupName": "Brotli"
    },
    {
      "description": "Keep the Dioxus framework and its build CLI aligned",
      "matchPackageNames": ["dioxus", "dioxus-cli"],
      "groupName": "Dioxus",
      "separateMajorMinor": false
    },
    {
      "description": "Pin the base images of the Dockerfiles by digest: a tag such as rust:1-slim-trixie moves, and an image is then built from whatever it names that day. The actions are pinned by commit the same way (helpers:pinGitHubActionDigests)",
      "matchManagers": ["dockerfile"],
      "pinDigests": true
    },
    {
      "description": "Move the service images the weekly workflow tests against with the Compose stack's",
      "matchManagers": ["docker-compose", "github-actions"],
      "matchPackageNames": ["postgres", "redis"],
      "groupName": "Service images"
    },
    {
      "description": "Test non-major GitHub Actions updates together",
      "matchManagers": ["github-actions"],
      "matchUpdateTypes": ["minor", "patch", "digest", "pinDigest"],
      "groupName": "GitHub Actions (non-major)"
    },
    {
      "description": "Automerge stable non-major updates after CI succeeds. GitHub Actions are left out: nearly all of them run in the release workflow or in the gates it calls, with the repository's tokens, so their updates wait for a review",
      "matchManagers": [
        "cargo",
        "docker-compose",
        "dockerfile",
        "helm-values",
        "helmv3"
      ],
      "matchCurrentVersion": "/^v?[1-9][0-9]*(\\.[0-9]+)*/",
      "matchUpdateTypes": ["minor", "patch", "digest", "pinDigest"],
      "additionalBranchPrefix": "automerge-",
      "automerge": true,
      "automergeType": "pr"
    },
    {
      "description": "Automerge lock refreshes that stay within declared constraints",
      "matchManagers": ["cargo", "helmv3"],
      "matchUpdateTypes": ["lockFileMaintenance"],
      "additionalBranchPrefix": "automerge-",
      "automerge": true,
      "automergeType": "pr"
    },
    {
      "description": "Never automerge what a release publishes with: the Dockerfiles of the published images, their base images' digests included. Listed after the automerge rules because the last matching rule wins",
      "matchFileNames": ["docker/Dockerfile.server", "docker/Dockerfile.worker", "docker/Dockerfile.web"],
      "additionalBranchPrefix": "",
      "automerge": false
    },
    {
      "description": "Require dashboard approval for breaking updates",
      "matchUpdateTypes": ["major"],
      "dependencyDashboardApproval": true
    }
  ]
}